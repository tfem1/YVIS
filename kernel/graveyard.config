# GraveyardOS changes to kernel/base.config (merged with scripts/kconfig/merge_config.sh,
# then completed by `make olddefconfig`). Keep this short: every line is a
# difference to explain.

# Identity: `uname -r` is 7.1.8-graveyard.
CONFIG_LOCALVERSION="-graveyard"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="graveyard"

# Options that need tools the base system does not have (the book turns the
# first one off for the same reason, 10.3.1).
#   kernel headers in /sys: cpio
# CONFIG_IKHEADERS is not set
#   BTF type information: pahole
# CONFIG_DEBUG_INFO_BTF is not set
#   Rust drivers: rustc and bindgen
# CONFIG_RUST is not set

# Panic screen as text (book 10.3.1: the QR code needs Rust, the default
# "user" screen hides the messages needed to diagnose a panic).
CONFIG_DRM_PANIC_SCREEN="kmsg"
# CONFIG_DRM_PANIC_SCREEN_QR_CODE is not set

# No debugging information: it multiplies the build's time and size, and the
# book strips the system anyway (8.84).
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
