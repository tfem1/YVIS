#!/usr/bin/python3
"""Build the YVIS initramfs from the installed system's own programs.

    yvis-mkinitramfs [kernel release] [output file]

Defaults: the running kernel, /boot/initramfs-<release>.img. The image holds
the init script (/usr/share/yvis/initramfs/init), bash, mount, kmod, udev
with its storage rules, the libraries they need, and the kernel modules for
storage controllers, disks and file systems with their dependencies. It is a
cpio archive ("newc" format, written here: the base system has no cpio)
compressed with zstd.
"""
import os
import shutil
import stat
import subprocess
import sys
import tempfile

SHARE = "/usr/share/yvis/initramfs"

# Programs: found on PATH. Enough to mount a root file system and to repair
# a boot by hand from the rescue shell.
PROGRAMS = [
    "bash", "cat", "cp", "ls", "ln", "mkdir", "sleep", "dmesg",
    "mount", "umount", "mountpoint", "switch_root", "blkid", "losetup", "setsid",
    "kmod", "udevadm",
]
KMOD_NAMES = ["modprobe", "insmod", "rmmod", "lsmod", "depmod"]
UDEV_HELPERS = ["ata_id", "scsi_id", "cdrom_id"]
UDEV_RULES = [
    "50-udev-default.rules", "60-block.rules", "60-cdrom_id.rules",
    "60-persistent-storage.rules", "64-btrfs.rules", "80-drivers.rules",
]
# Kernel modules, relative to /usr/lib/modules/<release>/kernel: whole
# directories of storage and file system drivers, plus single modules.
MODULE_DIRS = [
    "drivers/ata", "drivers/nvme", "drivers/scsi", "drivers/block", "drivers/cdrom",
    "drivers/usb/storage", "drivers/usb/host", "drivers/mmc", "drivers/virtio",
    "drivers/message/fusion", "drivers/md", "drivers/ufs", "drivers/hv",
    "drivers/pci/controller", "drivers/hid", "drivers/input/keyboard",
    "fs/squashfs", "fs/overlayfs", "fs/isofs", "fs/udf", "fs/fat", "fs/exfat",
    "fs/ext4", "fs/btrfs", "fs/xfs", "fs/f2fs", "fs/erofs", "fs/nls",
]
MODULE_FILES = ["modules.order", "modules.builtin", "modules.builtin.modinfo"]


def die(message):
    sys.exit(f"yvis-mkinitramfs: {message}")


def libraries(path):
    """Shared libraries a program needs, as ldd resolves them."""
    out = subprocess.run(["ldd", path], capture_output=True, text=True).stdout
    libs = []
    for line in out.splitlines():
        words = line.split()
        if "=>" in words and len(words) >= 3 and words[2].startswith("/"):
            libs.append(words[2])
        elif words and words[0].startswith("/"):
            libs.append(words[0])  # the dynamic linker
        elif "not" in words and "found" in words:
            die(f"{path} needs {words[0]}, which is missing")
    return libs


def module_closure(release_dir, selected):
    """The selected modules plus everything modules.dep says they need."""
    deps = {}
    with open(os.path.join(release_dir, "modules.dep")) as f:
        for line in f:
            name, _, rest = line.partition(":")
            deps[name] = rest.split()
    todo, done = list(selected), set()
    while todo:
        m = todo.pop()
        if m in done:
            continue
        if m not in deps:
            die(f"{m} is not in modules.dep (run depmod)")
        done.add(m)
        todo.extend(deps[m])
    return sorted(done)


def newc(out, root):
    """Write the tree under root as a cpio "newc" archive, plus /dev/console."""

    def entry(name, mode, data=b"", nlink=1, rdev=(0, 0)):
        name = name.encode() + b"\0"
        fields = [entry.ino, mode, 0, 0, nlink, 0, len(data), 0, 0, rdev[0], rdev[1], len(name), 0]
        entry.ino += 1
        header = b"070701" + b"".join(b"%08X" % v for v in fields)
        out.write(header + name)
        out.write(b"\0" * (-(len(header) + len(name)) % 4))
        out.write(data)
        out.write(b"\0" * (-len(data) % 4))

    entry.ino = 1
    for base, dirs, files in os.walk(root):
        dirs.sort()
        rel = os.path.relpath(base, root)
        if rel != ".":
            entry(rel, stat.S_IFDIR | 0o755, nlink=2)
        for d in list(dirs):  # a link to a directory is an entry, not a walk
            p = os.path.join(base, d)
            if os.path.islink(p):
                entry(os.path.relpath(p, root), stat.S_IFLNK | 0o777, os.readlink(p).encode())
                dirs.remove(d)
        for f in sorted(files):
            p = os.path.join(base, f)
            rel_p = os.path.relpath(p, root)
            st = os.lstat(p)
            if stat.S_ISLNK(st.st_mode):
                entry(rel_p, stat.S_IFLNK | 0o777, os.readlink(p).encode())
            else:
                with open(p, "rb") as fh:
                    entry(rel_p, stat.S_IFREG | (st.st_mode & 0o777), fh.read())
    # The kernel opens /dev/console for init before devtmpfs is mounted.
    entry("dev/console", stat.S_IFCHR | 0o600, rdev=(5, 1))
    entry("dev/null", stat.S_IFCHR | 0o666, rdev=(1, 3))
    entry("TRAILER!!!", 0)


def build(release, output, share=SHARE, sysroot="/"):
    release_dir = os.path.join(sysroot, "usr/lib/modules", release)
    if not os.path.isfile(os.path.join(release_dir, "modules.dep")):
        die(f"no kernel modules for {release} in {release_dir}")

    work = tempfile.mkdtemp(prefix="yvis-initramfs.")
    root = os.path.join(work, "root")
    for d in ["dev", "proc", "sys", "run", "sysroot", "tmp", "etc", "usr/bin", "usr/sbin", "usr/lib"]:
        os.makedirs(os.path.join(root, d))
    for link, target in [("bin", "usr/bin"), ("sbin", "usr/sbin"), ("lib", "usr/lib"), ("lib64", "usr/lib")]:
        os.symlink(target, os.path.join(root, link))

    def place(src, dst=None):
        """Copy a file to the same path in the image (following links)."""
        dst = os.path.join(root, (dst or src).lstrip("/"))
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if not os.path.exists(dst):
            shutil.copy2(src, dst)
        return dst

    def program(path):
        place(os.path.realpath(path), path)
        for lib in libraries(path):
            place(os.path.realpath(lib), lib)

    for name in PROGRAMS:
        path = shutil.which(name, path="/usr/bin:/usr/sbin")
        if not path:
            die(f"{name} is not installed")
        program(path)
    os.symlink("bash", os.path.join(root, "usr/bin/sh"))
    for name in KMOD_NAMES:
        os.symlink("../bin/kmod", os.path.join(root, "usr/sbin", name))

    # udev: the daemon is udevadm under another name
    os.makedirs(os.path.join(root, "usr/lib/systemd"))
    os.symlink("../../bin/udevadm", os.path.join(root, "usr/lib/systemd/systemd-udevd"))
    for name in UDEV_HELPERS:
        path = f"/usr/lib/udev/{name}"
        if os.path.exists(path):
            program(path)
    for name in UDEV_RULES:
        path = f"/usr/lib/udev/rules.d/{name}"
        if os.path.exists(path):
            place(path)
    for path in ["/etc/passwd", "/etc/group"]:  # the rules name groups (disk, cdrom)
        place(path)

    # kernel modules with their dependencies, then the indexes modprobe reads
    selected = []
    for d in MODULE_DIRS:
        top = os.path.join(release_dir, "kernel", d)
        for base, _, files in os.walk(top):
            selected += [os.path.relpath(os.path.join(base, f), release_dir) for f in files if ".ko" in f]
    if not selected:
        die(f"no storage or file system module under {release_dir}/kernel")
    modules = module_closure(release_dir, selected)
    image_modules = os.path.join(root, "usr/lib/modules", release)
    for m in modules:
        dst = os.path.join(image_modules, m)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(os.path.join(release_dir, m), dst)
    for name in MODULE_FILES:
        shutil.copy2(os.path.join(release_dir, name), image_modules)
    subprocess.run(["depmod", "-b", root, release], check=True)

    # the init script and the live session's files
    shutil.copy2(os.path.join(share, "init"), os.path.join(root, "init"))
    os.chmod(os.path.join(root, "init"), 0o755)
    shutil.copytree(os.path.join(share, "live"), os.path.join(root, "live"), symlinks=True)

    tmp = output + ".new"
    with open(tmp, "wb") as f:
        os.chmod(tmp, 0o600)
        zstd = subprocess.Popen(["zstd", "-q", "-19", "-T0"], stdin=subprocess.PIPE, stdout=f)
        newc(zstd.stdin, root)
        zstd.stdin.close()
        if zstd.wait() != 0:
            die("zstd failed")
    os.replace(tmp, output)
    shutil.rmtree(work)
    size = os.path.getsize(output) / 1048576
    print(f"{output}: {len(modules)} modules, {size:.1f} MiB")


if __name__ == "__main__":
    if len(sys.argv) > 3 or (len(sys.argv) > 1 and sys.argv[1].startswith("-")):
        sys.exit(__doc__)
    rel = sys.argv[1] if len(sys.argv) > 1 else os.uname().release
    build(rel, sys.argv[2] if len(sys.argv) > 2 else f"/boot/initramfs-{rel}.img")
